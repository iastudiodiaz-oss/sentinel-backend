# =========================================================================
# SENTINEL CORE // VARIABLES DE ENTORNO DEL BACKEND
# Copia este archivo como .env y completa los valores
# =========================================================================

# Puerto del Servidor
PORT=3000
NODE_ENV=development

# -------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# En local puedes usar tu PostgreSQL o un servicio gratuito como Supabase / Neon
# -------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel_db
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
# O URL directa de conexión (ej: Supabase / Neon / Render):
# DATABASE_URL=postgresql://usuario:password@host:5432/sentinel_db?sslmode=require

# -------------------------------------------------------------------------
# SEGURIDAD & JWT (JSON Web Tokens)
# Genera claves aleatorias de 64 caracteres
# -------------------------------------------------------------------------
JWT_ACCESS_SECRET=sentinel_super_secret_access_key_2026_matrix_shield_jwt
JWT_REFRESH_SECRET=sentinel_super_secret_refresh_key_2026_matrix_shield_jwt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# -------------------------------------------------------------------------
# SERVICIO DE CORREO (Nodemailer // IONOS o Gmail)
# -------------------------------------------------------------------------
SMTP_HOST=smtp.ionos.es
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@diaziastudio.com
SMTP_PASS=tu_password_de_correo
EMAIL_FROM_NAME="Sentinel Security // Díaz IA Studio"
EMAIL_FROM_ADDRESS="info@diaziastudio.com"
